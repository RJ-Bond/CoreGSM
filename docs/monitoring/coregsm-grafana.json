    },
    {
      "type": "timeseries",
      "title": "Время работы backend",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "coregsm_uptime_seconds",
          "legendFormat": "секунды",
