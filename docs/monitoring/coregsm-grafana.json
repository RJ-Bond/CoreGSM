        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "id": 11
    },
    {
      "type": "timeseries",
